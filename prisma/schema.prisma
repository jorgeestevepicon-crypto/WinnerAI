// WinnerAI database schema
// Prisma ORM (classic prisma-client-js generator) + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  role           Role      @default(USER)

  onboardingCompleted Boolean @default(false)
  onboardingData      Json?
  preferences         Json?
  suspended           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  products      Product[]
  stores        Store[]
  adCampaigns   AdCampaign[]
  shopifyConnections ShopifyConnection[]
  aiJobs        AIJob[]
  aiConversations AIConversation[]
  activityLogs  ActivityLog[]
  suppliers     Supplier[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

enum ProductSource {
  DEMO
  MANUAL
  ALIEXPRESS
  AMAZON
  GOOGLE_TRENDS
  META_AD_LIBRARY
  TIKTOK
  OTHER
}

model Supplier {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  url        String?
  country    String?
  rating     Float?
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  userId      String?

  title       String
  description String?       @db.Text
  images      String[]
  category    String?
  source      ProductSource @default(DEMO)
  sourceUrl   String?

  supplierId  String?
  supplierUrl String?

  cost           Float?
  price          Float?
  currency       String   @default("USD")
  shippingCost   Float?
  estimatedMargin Float?

  demandScore      Float?
  trendScore       Float?
  competitionScore Float?
  saturationScore  Float?
  engagementScore  Float?
  growthScore      Float?
  winningScore     Float?

  country  String?
  metadata Json?

  saved     Boolean @default(false)
  featured  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  supplier   Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  analyses   ProductAnalysis[]
  stores     Store[]
  campaigns  AdCampaign[]

  @@index([userId])
  @@index([winningScore])
  @@index([category])
  @@index([source])
}

model ProductAnalysis {
  id        String  @id @default(cuid())
  productId String

  targetAudience     Json?
  problemsSolved     String[]
  advantages         String[]
  objections         String[]
  marketingAngles    String[]
  competitors        Json?
  opportunities      String[]
  risks              String[]
  recommendedPrice   Float?
  positioning        String? @db.Text
  aiVerdict          Json?

  source    String  @default("AI_GENERATED") // AI_GENERATED | ESTIMATED | VERIFIED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Stores
// ---------------------------------------------------------------------------

enum StoreStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  ERROR
}

model Store {
  id        String      @id @default(cuid())
  userId    String
  productId String?

  name       String
  status     StoreStatus @default(DRAFT)
  brand      Json
  theme      Json
  document   Json        // full Store JSON (brand + theme + sections), source of truth
  locale     String      @default("en")
  country    String?

  shopifyDomain String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  sections StoreSection[]
  versions StoreVersion[]
  settings StoreSettings?

  @@index([userId])
  @@index([productId])
}

model StoreSection {
  id       String @id @default(cuid())
  storeId  String
  type     String
  order    Int
  settings Json
  hidden   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model StoreVersion {
  id        String  @id @default(cuid())
  storeId   String
  version   Int
  document  Json
  label     String?
  createdBy String? // "user" | "ai"

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, version])
  @@index([storeId])
}

model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique

  seoTitle       String?
  seoDescription String?
  favicon        String?
  customDomain   String?
  analyticsId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Shopify
// ---------------------------------------------------------------------------

enum ShopifyConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model ShopifyConnection {
  id     String @id @default(cuid())
  userId String

  shopDomain          String
  accessTokenEncrypted String? @db.Text
  scope               String?
  status              ShopifyConnectionStatus @default(DISCONNECTED)
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopDomain])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Ads
// ---------------------------------------------------------------------------

enum AdPlatform {
  META
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE
  PINTEREST
  YOUTUBE
}

enum AdObjective {
  SALES
  CONVERSIONS
  TRAFFIC
  LEADS
  ENGAGEMENT
  PRODUCT_AWARENESS
}

enum AdCampaignStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

model AdCampaign {
  id        String @id @default(cuid())
  userId    String
  productId String?

  name      String
  platform  AdPlatform
  objective AdObjective
  audience  Json?
  status    AdCampaignStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  creatives AdCreative[]

  @@index([userId])
  @@index([productId])
}

model AdCreative {
  id         String @id @default(cuid())
  campaignId String

  style      String // UGC, Premium, Minimal, Lifestyle, ...
  format     String // instagram_feed, story, reel, ...
  favorite   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  campaign AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variants AdVariant[]

  @@index([campaignId])
}

model AdVariant {
  id         String @id @default(cuid())
  creativeId String

  label       String  // "Variant A", "Variant B", ...
  angle       String?
  hook        String? @db.Text
  primaryText String? @db.Text
  headline    String?
  description String? @db.Text
  cta         String?
  imageUrl    String?
  imagePrompt String? @db.Text

  metrics Json? // CTR/CPC/etc when real campaign data exists

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creative AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId])
}

model GeneratedCopy {
  id     String  @id @default(cuid())
  userId String?

  kind    String // product_title, description, headline, email, landing, social, ad
  input   Json
  output  Json

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model Analytics {
  id     String  @id @default(cuid())
  userId String?
  storeId String?

  source String // shopify | meta | tiktok | google | pinterest | demo
  date   DateTime

  revenue      Float?
  orders       Int?
  visitors     Int?
  conversionRate Float?
  ctr          Float?
  cpc          Float?
  cpa          Float?
  roas         Float?
  impressions  Int?
  spend        Float?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([storeId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// AI Jobs / Conversations
// ---------------------------------------------------------------------------

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIJobType {
  PRODUCT_ANALYSIS
  STORE_GENERATION
  BRAND_GENERATION
  AD_COPY
  AD_IMAGE
  AD_BULK
  MARKETING_STRATEGY
  VIDEO_STORYBOARD
  GROWTH_RECOMMENDATION
  STORE_AI_EDIT
}

model AIJob {
  id     String @id @default(cuid())
  userId String

  type     AIJobType
  status   AIJobStatus @default(PENDING)
  input    Json
  output   Json?
  error    String?
  progress Int         @default(0)
  attempts Int         @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  startedAt DateTime?
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
}

model AIConversation {
  id     String  @id @default(cuid())
  userId String
  title  String?
  context Json?  // e.g. { scope: "product", productId: "..." }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String @id @default(cuid())
  conversationId String

  role    String // user | assistant | system
  content String @db.Text
  meta    Json?

  createdAt DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Activity
// ---------------------------------------------------------------------------

model ActivityLog {
  id     String  @id @default(cuid())
  userId String

  action     String // product_analyzed, store_created, ad_generated, store_published, shopify_connected...
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
