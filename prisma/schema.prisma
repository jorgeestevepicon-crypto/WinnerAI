// WinnerAI database schema
// Prisma ORM (classic prisma-client-js generator) + PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  role           Role      @default(USER)

  onboardingCompleted Boolean @default(false)
  onboardingData      Json?
  preferences         Json?
  suspended           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  products      Product[]
  stores        Store[]
  adCampaigns   AdCampaign[]
  shopifyConnections ShopifyConnection[]
  aliexpressConnection AliExpressConnection?
  winningScoreConfig   WinningScoreConfig?
  aiJobs        AIJob[]
  aiConversations AIConversation[]
  activityLogs  ActivityLog[]
  suppliers     Supplier[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Billing
// ---------------------------------------------------------------------------

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

enum ProductSource {
  DEMO
  MANUAL
  ALIEXPRESS
  AMAZON
  GOOGLE_TRENDS
  META_AD_LIBRARY
  TIKTOK
  OTHER
}

// ---------------------------------------------------------------------------
// Winning Products (dropshipping product validation module)
// ---------------------------------------------------------------------------

enum WinningProductStatus {
  CANDIDATE
  IN_TEST
  WINNER
  DISCARDED
}

// Where the user personally spotted this product being advertised — never
// scraped, always a manual note the user enters themselves alongside a link.
enum DiscoveryOrigin {
  TIKTOK
  INSTAGRAM
  META_ADS
  OTHER
}

enum CompetitionLevel {
  LOW
  MEDIUM
  HIGH
}

enum TrendDirection {
  RISING
  STABLE
  FALLING
}

// One row per time the product's real price/order-count/rating is captured
// (initial discovery, a manual "refresh from AliExpress", or a later
// re-search) — lets the score engine compute genuine order-growth between
// captures instead of a single point-in-time snapshot.
model ProductSnapshot {
  id        String   @id @default(cuid())
  productId String

  price     Float?
  cost      Float?
  orders    Int?
  rating    Float?

  capturedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

// Manual, user-entered signals the AliExpress API has no way to provide.
// googleTrendsManual is pre-filled from the real Google Trends integration
// when available (see features/winning-products/server/scoring.ts) — this
// field exists so the user can override it, not as the primary source.
model ProductManualSignal {
  id        String @id @default(cuid())
  productId String @unique

  wowEffect             Int?
  foundInPhysicalStores Boolean?
  competitionLevel      CompetitionLevel?
  googleTrendsManual    TrendDirection?
  notes                 String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// A single ad test run for a product (any platform — entered manually, this
// app never has real ad-platform credentials for arbitrary user accounts).
// CTR/CPC/CPA/ROAS/net profit are always computed from these raw numbers at
// read time (features/winning-products/server/ad-test-metrics.ts), never
// stored, so they can't drift out of sync with an edited field.
model ProductAdTest {
  id        String @id @default(cuid())
  productId String

  name      String?
  platform  String?
  startDate DateTime?
  endDate   DateTime?

  dailyBudget Float?
  totalSpend  Float?
  impressions Int?
  clicks      Int?
  addToCarts  Int?
  purchases   Int?
  revenue     Float?
  currency    String @default("USD")

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Gate before scaling ad spend on a product. readyToScale is only ever set
// true server-side (features/winning-products/server/actions.ts) when the
// three checks above it are already true — never settable directly by the
// client, so the gate can't be bypassed from the UI.
model ProductSupplierChecklist {
  id        String  @id @default(cuid())
  productId String  @unique

  sampleOrdered      Boolean @default(false)
  sampleReceived     Boolean @default(false)
  qualityOk          Boolean @default(false)
  actualShippingDays Int?
  notes              String? @db.Text
  readyToScale       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// Single editable place for the Winning Products scoring weights/thresholds
// (features/winning-products/server/config.ts provides defaults + get-or-create).
// One row per user, same convention as AliExpressConnection.
model WinningScoreConfig {
  id     String @id @default(cuid())
  userId String @unique

  // Weights (0-1-ish, relative to each other — normalized/redistributed by
  // the score engine when a given factor's data isn't available yet).
  weightMargin           Float @default(0.20)
  weightPriceRangeFit    Float @default(0.10)
  weightDemand           Float @default(0.15)
  weightDemandGrowth     Float @default(0.10)
  weightProviderQuality  Float @default(0.10)
  weightLogistics        Float @default(0.10)
  weightWowEffect        Float @default(0.10)
  weightPhysicalStores   Float @default(0.05)
  weightCompetitionLevel Float @default(0.05)
  weightGoogleTrends     Float @default(0.05)

  // Thresholds
  marginTargetMultiplier Float  @default(3)
  idealPriceMin          Float  @default(20)
  idealPriceMax          Float  @default(60)
  priceCurrency          String @default("EUR")
  targetCountry          String @default("ES")
  maxIdealWeightGrams    Float  @default(1000)
  minRoasForWinner       Float  @default(2.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Supplier {
  id         String   @id @default(cuid())
  userId     String?
  name       String
  url        String?
  country    String?
  rating     Float?
  metadata   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  userId      String?

  title       String
  description String?       @db.Text
  images      String[]
  category    String?
  source      ProductSource @default(DEMO)
  sourceUrl   String?

  supplierId  String?
  supplierUrl String?

  cost           Float?
  price          Float?
  currency       String   @default("USD")
  shippingCost   Float?
  estimatedMargin Float?

  demandScore      Float?
  trendScore       Float?
  competitionScore Float?
  saturationScore  Float?
  engagementScore  Float?
  growthScore      Float?
  winningScore     Float?

  country  String?
  metadata Json?

  saved     Boolean @default(false)
  featured  Boolean @default(false)

  // Dropshipping "winning product" validation module (Winning Products) —
  // populated only for products that entered that workflow; every other
  // source/row leaves these null, same convention as the score columns above.
  winningStatus   WinningProductStatus?
  weightGrams     Int?
  shippingDays    Int?
  storeRating     Float?
  reviewCount     Int?
  discoveryOrigin DiscoveryOrigin?
  discoveryUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  supplier   Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  analyses   ProductAnalysis[]
  stores     Store[]
  campaigns  AdCampaign[]

  snapshots          ProductSnapshot[]
  manualSignal       ProductManualSignal?
  adTests            ProductAdTest[]
  supplierChecklist  ProductSupplierChecklist?

  @@index([userId])
  @@index([winningScore])
  @@index([category])
  @@index([source])
  @@index([winningStatus])
}

model ProductAnalysis {
  id        String  @id @default(cuid())
  productId String

  targetAudience     Json?
  problemsSolved     String[]
  advantages         String[]
  objections         String[]
  marketingAngles    String[]
  competitors        Json?
  opportunities      String[]
  risks              String[]
  recommendedPrice   Float?
  positioning        String? @db.Text
  aiVerdict          Json?

  source    String  @default("AI_GENERATED") // AI_GENERATED | ESTIMATED | VERIFIED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Stores
// ---------------------------------------------------------------------------

enum StoreStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  ERROR
}

model Store {
  id        String      @id @default(cuid())
  userId    String
  productId String?

  name       String
  status     StoreStatus @default(DRAFT)
  brand      Json
  theme      Json
  document   Json        // full Store JSON (brand + theme + sections), source of truth
  locale     String      @default("en")
  country    String?

  shopifyDomain    String?
  shopifyProductId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  sections StoreSection[]
  versions StoreVersion[]
  settings StoreSettings?
  orders   StoreOrder[]

  @@index([userId])
  @@index([productId])
}

model StoreSection {
  id       String @id @default(cuid())
  storeId  String
  type     String
  order    Int
  settings Json
  hidden   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model StoreVersion {
  id        String  @id @default(cuid())
  storeId   String
  version   Int
  document  Json
  label     String?
  createdBy String? // "user" | "ai"

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, version])
  @@index([storeId])
}

model StoreSettings {
  id      String @id @default(cuid())
  storeId String @unique

  seoTitle       String?
  seoDescription String?
  favicon        String?
  customDomain   String?
  analyticsId    String?

  shippingPolicy String?
  returnPolicy   String?
  privacyPolicy  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Store orders (WinnerAI's own storefront checkout — Stripe, not Shopify)
// ---------------------------------------------------------------------------

enum StoreOrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

model StoreOrder {
  id     String @id @default(cuid())
  storeId String
  userId  String // store owner, denormalized for fast dashboard queries

  productTitle String
  quantity     Int
  unitPrice    Float
  currency     String
  totalAmount  Float

  customerEmail   String
  customerName    String?
  shippingAddress Json?

  status StoreOrderStatus @default(PENDING)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Shopify
// ---------------------------------------------------------------------------

enum ShopifyConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model ShopifyConnection {
  id     String @id @default(cuid())
  userId String

  shopDomain          String
  accessTokenEncrypted String? @db.Text
  scope               String?
  status              ShopifyConnectionStatus @default(DISCONNECTED)
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopDomain])
  @@index([userId])
}

enum AliExpressConnectionStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

// AliExpress's Dropshipping API requires an OAuth-authorized account per
// user (unlike the Affiliate API's simple app-level key), so this mirrors
// ShopifyConnection's per-user token storage rather than a plain env var.
model AliExpressConnection {
  id     String @id @default(cuid())
  userId String @unique

  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  expiresAt             DateTime?
  status                AliExpressConnectionStatus @default(DISCONNECTED)
  lastError             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Ads
// ---------------------------------------------------------------------------

enum AdPlatform {
  META
  FACEBOOK
  INSTAGRAM
  TIKTOK
  GOOGLE
  PINTEREST
  YOUTUBE
}

enum AdObjective {
  SALES
  CONVERSIONS
  TRAFFIC
  LEADS
  ENGAGEMENT
  PRODUCT_AWARENESS
}

enum AdCampaignStatus {
  DRAFT
  GENERATING
  READY
  ARCHIVED
}

model AdCampaign {
  id        String @id @default(cuid())
  userId    String
  productId String?

  name      String
  platform  AdPlatform
  objective AdObjective
  audience  Json?
  status    AdCampaignStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  creatives AdCreative[]

  @@index([userId])
  @@index([productId])
}

model AdCreative {
  id         String @id @default(cuid())
  campaignId String

  style      String // UGC, Premium, Minimal, Lifestyle, ...
  format     String // instagram_feed, story, reel, ...
  favorite   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  campaign AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variants AdVariant[]

  @@index([campaignId])
}

model AdVariant {
  id         String @id @default(cuid())
  creativeId String

  label       String  // "Variant A", "Variant B", ...
  angle       String?
  hook        String? @db.Text
  primaryText String? @db.Text
  headline    String?
  description String? @db.Text
  cta         String?
  imageUrl    String?
  imagePrompt String? @db.Text

  videoUrl    String?
  videoTaskId String?
  videoStatus String? // PROCESSING | COMPLETED | FAILED
  videoError  String? @db.Text

  metrics Json? // CTR/CPC/etc when real campaign data exists

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creative AdCreative @relation(fields: [creativeId], references: [id], onDelete: Cascade)

  @@index([creativeId])
}

model GeneratedCopy {
  id     String  @id @default(cuid())
  userId String?

  kind    String // product_title, description, headline, email, landing, social, ad
  input   Json
  output  Json

  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

model Analytics {
  id     String  @id @default(cuid())
  userId String?
  storeId String?

  source String // shopify | meta | tiktok | google | pinterest | demo
  date   DateTime

  revenue      Float?
  orders       Int?
  visitors     Int?
  conversionRate Float?
  ctr          Float?
  cpc          Float?
  cpa          Float?
  roas         Float?
  impressions  Int?
  spend        Float?

  isDemo Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([storeId])
  @@index([date])
}

// ---------------------------------------------------------------------------
// AI Jobs / Conversations
// ---------------------------------------------------------------------------

enum AIJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AIJobType {
  PRODUCT_ANALYSIS
  STORE_GENERATION
  BRAND_GENERATION
  AD_COPY
  AD_IMAGE
  AD_BULK
  MARKETING_STRATEGY
  VIDEO_STORYBOARD
  GROWTH_RECOMMENDATION
  STORE_AI_EDIT
}

model AIJob {
  id     String @id @default(cuid())
  userId String

  type     AIJobType
  status   AIJobStatus @default(PENDING)
  input    Json
  output   Json?
  error    String?
  progress Int         @default(0)
  attempts Int         @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  startedAt DateTime?
  finishedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
}

model AIConversation {
  id     String  @id @default(cuid())
  userId String
  title  String?
  context Json?  // e.g. { scope: "product", productId: "..." }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId])
}

model AIMessage {
  id             String @id @default(cuid())
  conversationId String

  role    String // user | assistant | system
  content String @db.Text
  meta    Json?

  createdAt DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Activity
// ---------------------------------------------------------------------------

model ActivityLog {
  id     String  @id @default(cuid())
  userId String

  action     String // product_analyzed, store_created, ad_generated, store_published, shopify_connected...
  entityType String?
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
