# ---------------------------------------------------------------------------
# WinnerAI environment variables
# Copy this file to .env and fill in the values you have.
# Anything left blank falls back to demo/mock behaviour (see DEMO_MODE below).
# ---------------------------------------------------------------------------

# Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/winnerai?schema=public"

# Auth.js -----------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Any account that registers with this email is automatically made an ADMIN.
ADMIN_EMAIL=""

# Optional OAuth providers (leave blank to only allow email/password)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Provider ---------------------------------------------------------------
# When unset, WinnerAI runs the AI layer in demo mode using deterministic
# mock generators instead of calling a real model.
AI_PROVIDER="demo" # demo | openai | anthropic
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_IMAGE_PROVIDER="demo" # demo | openai
AI_IMAGE_API_KEY=""

# Shopify ---------------------------------------------------------------
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_API_VERSION="2024-10"
SHOPIFY_APP_URL="http://localhost:3000"
SHOPIFY_TOKEN_ENCRYPTION_KEY=""

# Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# File storage (S3 / Supabase Storage / Cloudinary compatible) -----------
STORAGE_PROVIDER="local" # local | s3
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# AliExpress Dropshipping API (Open Platform) -----------------------------
# Requires applying for AliExpress Open Platform API access; not instant
# like the keys above. These identify the app itself — each user then
# additionally connects their own AliExpress account via OAuth from the
# Product Finder (stored per-user in the database, not an env var). Leave
# blank to keep the AliExpress source disabled ("not configured").
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""

# Google Trends (unofficial, no credentials needed) -------------------------
# Enriches AliExpress/other real product sources with real search-interest
# trend + growth signals, using Google's public (but unofficial/undocumented)
# Trends endpoints. Set to "false" only if this starts getting rate-limited
# or blocked in production and you want to disable it.
GOOGLE_TRENDS_ENABLED="true"

# Meta Ad Library API (official, free) --------------------------------------
# Enriches real product sources with a real ad-market signal (active-ad
# count + distinct advertiser count for the searched category/keyword) used
# as competition/saturation. Requires a Graph API access token from a Meta
# developer app that has completed Meta's identity confirmation for ad
# transparency data (business.facebook.com -> your app -> App Review ->
# Ad Library API access). Leave blank to keep this signal disabled
# ("not configured") — AliExpress search still works without it, just
# without real competition/saturation scores.
META_ADS_ACCESS_TOKEN=""

# App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE="true"
