# ---------------------------------------------------------------------------
# WinnerAI environment variables
# Copy this file to .env and fill in the values you have.
# Anything left blank falls back to demo/mock behaviour (see DEMO_MODE below).
# ---------------------------------------------------------------------------

# Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/winnerai?schema=public"

# Auth.js -----------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Any account that registers with this email is automatically made an ADMIN.
ADMIN_EMAIL=""

# Optional OAuth providers (leave blank to only allow email/password)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Provider ---------------------------------------------------------------
# When unset, WinnerAI runs the AI layer in demo mode using deterministic
# mock generators instead of calling a real model.
AI_PROVIDER="demo" # demo | openai | anthropic
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_IMAGE_PROVIDER="demo" # demo | openai
AI_IMAGE_API_KEY=""

# Shopify ---------------------------------------------------------------
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_API_VERSION="2024-10"
SHOPIFY_APP_URL="http://localhost:3000"
SHOPIFY_TOKEN_ENCRYPTION_KEY=""

# Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_AGENCY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# File storage (S3 / Supabase Storage / Cloudinary compatible) -----------
STORAGE_PROVIDER="local" # local | s3
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL=""

# App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEMO_MODE="true"
